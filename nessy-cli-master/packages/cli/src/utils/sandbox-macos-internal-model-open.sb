;; Docker TCP API stays blocked even though it uses unprivileged ports.
(deny network-outbound
    (remote ip "localhost:2375")
    (remote ip "localhost:2376"))

;; Sensitive UNIX sockets remain blocked.
(deny network-outbound
    (remote unix-socket (path-literal "/var/run/docker.sock"))
    (remote unix-socket (path-literal (string-append (param "HOME_DIR") "/.docker/run/docker.sock")))
    (remote unix-socket (path-literal "/var/run/syslog"))
    (remote unix-socket (path-literal "/var/run/mDNSResponder"))
    (remote unix-socket (path-literal "/var/run/cupsd")))
