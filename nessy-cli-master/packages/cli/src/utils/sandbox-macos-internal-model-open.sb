(version 1)

;; [nessy-fork] macos-internal-seatbelt-profile
;; Internal model macOS profile for Nessy CLI dp-auth sessions.
;; Weaker than external-model-open: localhost and browser automation are allowed for
;; trusted local MCP/IDE integrations. User secrets and browser profiles remain
;; denied below.
;; Seatbelt applies the last matching rule, so keep broad allows first, denies
;; after them, and deliberate narrow exceptions after the matching denies.

(deny default)

;; Runtime capabilities needed by common CLI tools and browser automation.
(allow process-fork)
(allow process-exec)
(allow process-exec-interpreter)
(allow signal (target self))
(allow sysctl-read)
(allow file-read-metadata)
(allow file-ioctl)
(allow ipc-posix-shm*)
(allow mach-register)
(allow iokit-open)

;; Browser automation and local MCP clients may need broad Mach/XPC discovery.
;; Keep explicit deny rules for known sensitive services after the blanket allow.
(allow mach-lookup)
(deny mach-lookup
    (global-name "com.apple.pboard")
    (global-name "com.apple.pasteboard.1")
    (global-name "com.apple.pasteboard.2")
    (global-name "com.apple.securityd")
    (global-name "com.apple.securityd.xpc")
    (global-name "com.apple.SecurityServer")
    (global-name "com.apple.tccd")
    (global-name "com.apple.tccd.system"))

;; Read access is broad for developer ergonomics. Secret paths are denied below.
(allow file-read*
    (subpath "/"))

;; Workspace and explicitly included directories.
(allow file-read* file-write*
    (subpath (param "TARGET_DIR"))
    (subpath (param "INCLUDE_DIR_0"))
    (subpath (param "INCLUDE_DIR_1"))
    (subpath (param "INCLUDE_DIR_2"))
    (subpath (param "INCLUDE_DIR_3"))
    (subpath (param "INCLUDE_DIR_4")))

;; Nessy runtime, temp, and cache locations.
(allow file-read* file-write*
    (subpath (param "TMP_DIR"))
    (subpath (param "CACHE_DIR"))
    (subpath (param "NESSY_DIR"))
    (subpath (param "RUNTIME_DIR"))
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/null")
    (literal "/dev/ptmx")
    (regex #"^/dev/tty.*")
    (regex #"^/dev/ttys[0-9]*$"))

;; Common package manager caches and tool state.
(allow file-read* file-write*
    (subpath (string-append (param "HOME_DIR") "/.npm"))
    (subpath (string-append (param "HOME_DIR") "/.nvm"))
    (subpath (string-append (param "HOME_DIR") "/.yarn"))
    (subpath (string-append (param "HOME_DIR") "/.pnpm-store"))
    (subpath (string-append (param "HOME_DIR") "/Library/pnpm"))
    (subpath (string-append (param "HOME_DIR") "/.bun"))
    (subpath (string-append (param "HOME_DIR") "/.deno"))
    (subpath (string-append (param "HOME_DIR") "/.cache"))
    (subpath (string-append (param "HOME_DIR") "/Library/Caches/pip"))
    (subpath (string-append (param "HOME_DIR") "/Library/Caches/uv"))
    (subpath (string-append (param "HOME_DIR") "/Library/Caches/pypoetry"))
    (subpath (string-append (param "HOME_DIR") "/Library/Caches/Yarn"))
    (subpath (string-append (param "HOME_DIR") "/Library/Caches/deno"))
    (subpath (string-append (param "HOME_DIR") "/Library/Caches/go-build"))
    (subpath (string-append (param "HOME_DIR") "/Library/Caches/ms-playwright"))
    (subpath (string-append (param "HOME_DIR") "/.local"))
    (subpath (string-append (param "HOME_DIR") "/.pyenv"))
    (subpath (string-append (param "HOME_DIR") "/.conda"))
    (subpath (string-append (param "HOME_DIR") "/Library/Application Support/pypoetry"))
    (subpath (string-append (param "HOME_DIR") "/.cargo"))
    (subpath (string-append (param "HOME_DIR") "/.rustup"))
    (subpath (string-append (param "HOME_DIR") "/go"))
    (subpath (string-append (param "HOME_DIR") "/.gradle"))
    (subpath (string-append (param "HOME_DIR") "/.m2"))
    (subpath (string-append (param "HOME_DIR") "/.sdkman"))
    (subpath (string-append (param "HOME_DIR") "/.ivy2"))
    (subpath (string-append (param "HOME_DIR") "/.konan"))
    (subpath (string-append (param "HOME_DIR") "/.nuget"))
    (subpath (string-append (param "HOME_DIR") "/.dotnet"))
    (subpath (string-append (param "HOME_DIR") "/.gem"))
    (subpath (string-append (param "HOME_DIR") "/.bundle"))
    (subpath (string-append (param "HOME_DIR") "/.composer"))
    (literal (string-append (param "HOME_DIR") "/.gitconfig"))
    (literal (string-append (param "HOME_DIR") "/.gitconfig.lock")))

;; Keep workspace trust decisions immutable inside the sandbox. Read is allowed.
(deny file-write*
    (literal (string-append (param "NESSY_DIR") "/trustedFolders.json")))

;; Sensitive user secrets and app state. Keep these denies after broad read/write rules.
(deny file-read* file-write*
    (subpath (string-append (param "HOME_DIR") "/.ssh"))
    (subpath (string-append (param "HOME_DIR") "/.aws"))
    (subpath (string-append (param "HOME_DIR") "/.gnupg"))
    (subpath (string-append (param "HOME_DIR") "/.kube"))
    (subpath (string-append (param "HOME_DIR") "/.terraform.d"))
    (subpath (string-append (param "HOME_DIR") "/.docker"))
    (subpath (string-append (param "HOME_DIR") "/.config"))
    (subpath (string-append (param "HOME_DIR") "/Library/Application Support/Code"))
    (subpath (string-append (param "HOME_DIR") "/Library/Application Support/Google"))
    (subpath (string-append (param "HOME_DIR") "/Library/Application Support/BraveSoftware"))
    (subpath (string-append (param "HOME_DIR") "/Library/Application Support/Microsoft Edge"))
    (subpath (string-append (param "HOME_DIR") "/Library/Application Support/Arc"))
    (subpath (string-append (param "HOME_DIR") "/Library/Application Support/Firefox"))
    (subpath (string-append (param "HOME_DIR") "/Library/Keychains"))
    (subpath (string-append (param "HOME_DIR") "/Library/LaunchAgents"))
    (subpath "/Library/LaunchDaemons")
    (subpath "/System/Library/LaunchDaemons")
    (literal (string-append (param "HOME_DIR") "/.npmrc"))
    (literal (string-append (param "HOME_DIR") "/.git-credentials"))
    (literal (string-append (param "HOME_DIR") "/.netrc"))
    (literal (string-append (param "HOME_DIR") "/.pypirc"))
    (literal (string-append (param "HOME_DIR") "/.zshrc"))
    (literal (string-append (param "HOME_DIR") "/.zshenv"))
    (literal (string-append (param "HOME_DIR") "/.zprofile"))
    (literal (string-append (param "HOME_DIR") "/.zsh_history"))
    (literal (string-append (param "HOME_DIR") "/.bashrc"))
    (literal (string-append (param "HOME_DIR") "/.bash_profile"))
    (literal (string-append (param "HOME_DIR") "/.bash_history"))
    (literal (string-append (param "HOME_DIR") "/.profile")))

;; Narrow exceptions under ~/.config for package-manager state that is not itself
;; a credential store. These rules intentionally come after the ~/.config deny.
(allow file-read* file-write*
    (subpath (string-append (param "HOME_DIR") "/.config/yarn"))
    (subpath (string-append (param "HOME_DIR") "/.config/pypoetry")))

;; Internal corporate exceptions used by dp/Spirit MCP integrations.
(allow file-read*
    (literal (string-append (param "HOME_DIR") "/.ssh/combined-ca.pem")))

(allow file-read* file-write*
    (subpath (string-append (param "HOME_DIR") "/.dp")))

;; External network and localhost are allowed. Privileged localhost ports
;; stay blocked because they commonly host system or corporate services. SBPL
;; does not support port ranges here, so the 1-1023 list is generated.
(allow network*)

;; BEGIN GENERATED privileged localhost ports - do not edit by hand
