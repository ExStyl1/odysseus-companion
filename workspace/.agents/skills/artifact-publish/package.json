{
  "name": "@loyalty-personalization/artifact-publish",
  "type": "module",
  "version": "0.0.0-stub",
  "initialVersion": "0.1.0",
  "description": "CLI to publish and update pages on t-artifacts, and to fetch its workflow and design guidance.",
  "bin": {
    "artifact-publish": "bin/artifact-publish.js"
  },
  "files": [
    "bin/artifact-publish.js",
    "dist/cli.js"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/cli.js",
    "publish:ci": "printf '@loyalty-personalization/artifact-publish\\n' | pvm publish --strategy stdin --forceVersioning tag --no-notify --bail",
    "test": "tsx --test src/cli.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://artifactory.tcsbank.ru/artifactory/api/npm/npm-hosted/"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "esbuild": "0.25.8",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  },
  "license": "UNLICENSED"
}
