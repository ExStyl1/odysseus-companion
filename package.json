{
  "name": "odysseus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "odysseus": "node tools/odysseus.mjs",
    "test": "node --test tests/*/*.test.mjs",
    "status": "node tools/odysseus.mjs status",
    "sync": "node tools/odysseus.mjs sync",
    "catalog:build": "node tools/build-skills-catalog.mjs",
