    "desktop:integration": "node tools/install-desktop-bridge.mjs",
    "catalog:ui": "node tools/build-ui-skills.mjs",
    "knowledge:setup": "node tools/graphify.mjs setup",
    "knowledge:refresh": "node tools/graphify.mjs refresh",
    "knowledge:status": "node tools/graphify.mjs doctor",
    "knowledge:sync": "node tools/knowledge-obsidian-sync.mjs",
    "setup": "node tools/first-run.mjs",
    "build:mac": "node tools/distribution/build-macos.mjs",
    "n8n:setup": "node tools/install-automation-runtime.mjs",
    "n8n:start": "node tools/automation-service.mjs start",
    "companion:setup": "node tools/companion/setup.mjs",
