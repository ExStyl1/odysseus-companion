  "blockedCommandHints": [
    {
      "command": "printf",
      "reason": "printf is not in the default read-only allowlist, the commands Plan and Don't ask modes run without approval.",
      "context": "Plan and Don't ask modes keep a narrow command surface so harmless-looking shell forms do not accidentally expand capability.",
      "tryInstead": [
        "Use `echo` for simple separators and labels.",
        "Allowlist printf in permissions.json if your workspace wants it to run without approval in Plan and Don't ask modes."
      ],
      "example": "echo '--- files ---'"
    },
    {
      "command": "sed",
      "reason": "Only print-only sed is in the default read-only allowlist of Plan and Don't ask modes.",
      "context": "Default safe pattern is `^sed\\s+-n\\b` (inspection, not in-place transformation).",
      "whenNotMatching": "^sed\\s+-n\\b",
      "tryInstead": [
        "Use `sed -n ...` for read-only inspection."
      ],
      "example": "sed -n '1,80p' file.txt"
    },
    {
      "command": "awk",
      "reason": "awk is blocked when the command appears to execute external commands.",
      "context": "Forms like `system(...)`, command-pipe `getline`, or `print | \"cmd\"` can run arbitrary processes.",
      "tryInstead": [
        "Use awk without execution primitives for read-only text extraction."
      ]
    },
    {
      "command": "gawk",
      "reason": "gawk is blocked when the command appears to execute external commands.",
      "context": "Forms like `system(...)`, command-pipe `getline`, or `print | \"cmd\"` can run arbitrary processes."
    },
    {
      "command": "mawk",
      "reason": "mawk is blocked when the command appears to execute external commands.",
      "context": "Forms like `system(...)`, command-pipe `getline`, or `print | \"cmd\"` can run arbitrary processes."
    },
    {
      "command": "nawk",
      "reason": "nawk is blocked when the command appears to execute external commands.",
      "context": "Forms like `system(...)`, command-pipe `getline`, or `print | \"cmd\"` can run arbitrary processes."
    },
    {
      "command": "xargs",
      "reason": "xargs is not in the read-only allowlist of Plan and Don't ask modes because it can execute arbitrary commands from input.",
      "tryInstead": [
        "Use dedicated read-only commands directly."
      ]
    }
  ],
