   sameRuntimeBody / crossRuntimeBody из packages/shared/src/i18n/locales/ru.json;
   заголовок у iOS один на оба случая и несёт имя цели, поэтому он не
   дословная копия двух десктопных заголовков. */
"Switch to %@?" = "Переключить на %@?";
"Switch" = "Переключить";
"The conversation continues on the same runtime. The next reply re-reads the history, so it may take longer than usual." = "Диалог продолжится на том же рантайме. Следующий ответ перечитает историю заново, поэтому может прийти медленнее обычного.";
