{
  // Type coverage for the build/release GATE scripts.
  //
  // `scripts/build/codex-integrity.ts` can fail a release, and until this file
  // existed nothing typechecked it: `bun run typecheck:all` walks the packages
  // and `apps/electron`, and `apps/electron/tsconfig.json` includes only
  // `src/**/*`, so every script under `scripts/` was outside the type gate.
  // (`packages/codex-agent-server/src/manifest-verifier.ts` IS covered — the
  // electron program pulls it in through its imports — but the gate that checks
  // the packaged artifact was not.)
  //
  // Wired into the root `typecheck:all` as `typecheck:build-scripts`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun", "node"]
  },
  "include": ["**/*.ts"]
}
