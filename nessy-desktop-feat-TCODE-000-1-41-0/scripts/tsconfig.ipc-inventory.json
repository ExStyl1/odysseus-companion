{
  // `scripts/ipc-inventory.ts` and its `bun test` reader.
  //
  // It imports `RPC_CHANNELS` from `apps/electron/src/shared/types.ts`, so any
  // program that compiles it also compiles Electron app source. Extending
  // `apps/electron/tsconfig.json` is the point: the imported code is then
  // checked under exactly the flags and path aliases it was authored against,
  // and if those flags change this project follows them instead of drifting.
  //
  // Run by `typecheck:scripts` alongside `scripts/tsconfig.json`.
  "extends": "../apps/electron/tsconfig.json",
  "include": ["ipc-inventory.ts", "ipc-inventory.test.ts"],
  "exclude": []
}
