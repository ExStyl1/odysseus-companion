{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // No `rootDir`: unlike its siblings this package imports `@nessy-agent/shared`
    // source by relative path (`../../shared/src/llm/think-splitter.ts`), so a
    // rootDir of `./src` puts those files outside the program root (TS6059).
    // We only ever run this config with `--noEmit`, and rootDir exists to shape
    // emit output, so dropping it costs nothing here.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
