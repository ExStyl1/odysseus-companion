{
  "schemaVersion": 2,
  "owner": "Nestor Cloud A2A adapter and turn",
  "builtInTools": [
    "read_file",
    "list_files",
    "search_files",
    "write_to_file",
    "replace_in_file",
    "execute_command",
    "ask_followup_question",
    "plan_mode_respond",
    "activate_skill"
  ],
  "terminalTools": [
    "ask_followup_question",
    "plan_mode_respond"
  ],
  "builtinCases": [
    {
      "input": { "id": "builtin-read", "index": 0, "name": "read_file", "arguments": "{\"path\":\"README.md\"}" },
      "expectedArgs": { "path": "README.md" },
      "expectedLocal": { "id": "builtin-read", "permissionRequestId": "nestor-cloud-builtin-read", "displayName": "read_file", "operation": { "kind": "read_file", "path": "README.md" }, "permission": { "toolName": "Read", "input": { "file_path": "README.md" } } },
      "terminal": false
    },
    {
      "input": { "id": "builtin-list", "index": 1, "name": "list_files", "arguments": "{\"path\":\"src\"}" },
      "expectedArgs": { "path": "src" },
      "expectedLocal": { "id": "builtin-list", "permissionRequestId": "nestor-cloud-builtin-list", "displayName": "list_files", "operation": { "kind": "list_files", "path": "src", "recursive": false }, "permission": { "toolName": "Read", "input": { "file_path": "src" } } },
      "terminal": false
    },
    {
      "input": { "id": "builtin-search", "index": 2, "name": "search_files", "arguments": "{\"path\":\"src\",\"regex\":\"needle\",\"file_pattern\":\"*.ts\"}" },
      "expectedArgs": { "path": "src", "regex": "needle", "file_pattern": "*.ts" },
      "expectedLocal": { "id": "builtin-search", "permissionRequestId": "nestor-cloud-builtin-search", "displayName": "search_files", "operation": { "kind": "grep", "pattern": "needle", "path": "src", "glob": "*.ts" }, "permission": { "toolName": "Read", "input": { "file_path": "src" } } },
      "terminal": false
    },
    {
      "input": { "id": "builtin-write", "index": 3, "name": "write_to_file", "arguments": "{\"path\":\"out.txt\",\"content\":\"value\"}" },
      "expectedArgs": { "path": "out.txt", "content": "value" },
      "expectedLocal": { "id": "builtin-write", "permissionRequestId": "nestor-cloud-builtin-write", "displayName": "write_to_file", "operation": { "kind": "write_file", "path": "out.txt", "content": "value" }, "permission": { "toolName": "Write", "input": { "file_path": "out.txt", "content": "value" }, "type": "file_write" } },
      "terminal": false
    },
    {
      "input": { "id": "builtin-replace", "index": 4, "name": "replace_in_file", "arguments": "{\"path\":\"out.txt\",\"diff\":\"<<<<<<< SEARCH\\nold\\n=======\\nnew\\n>>>>>>> REPLACE\"}" },
      "expectedArgs": { "path": "out.txt", "diff": "<<<<<<< SEARCH\nold\n=======\nnew\n>>>>>>> REPLACE" },
      "expectedLocal": { "id": "builtin-replace", "permissionRequestId": "nestor-cloud-builtin-replace", "displayName": "replace_in_file", "operation": { "kind": "edit_file", "path": "out.txt", "edits": [{ "oldText": "old", "newText": "new" }] }, "permission": { "toolName": "Edit", "input": { "file_path": "out.txt", "diff": "<<<<<<< SEARCH\nold\n=======\nnew\n>>>>>>> REPLACE" }, "type": "file_write" } },
      "terminal": false
    },
    {
      "input": { "id": "builtin-exec", "index": 5, "name": "execute_command", "arguments": "{\"command\":\"pwd\"}" },
      "expectedArgs": { "command": "pwd" },
      "expectedLocal": { "id": "builtin-exec", "permissionRequestId": "nestor-cloud-builtin-exec", "displayName": "execute_command", "operation": { "kind": "bash", "command": "pwd" }, "permission": { "toolName": "Bash", "input": { "command": "pwd" }, "type": "bash", "command": "pwd" } },
      "terminal": false
    },
    {
      "input": { "id": "builtin-ask", "index": 6, "name": "ask_followup_question", "arguments": "{\"question\":\"continue?\"}" },
      "expectedArgs": { "question": "continue?" },
      "expectedLocal": null,
      "terminal": true
    },
    {
      "input": { "id": "builtin-plan", "index": 7, "name": "plan_mode_respond", "arguments": "{\"response\":\"plan\"}" },
      "expectedArgs": { "response": "plan" },
      "expectedLocal": null,
      "terminal": true
    },
    {
      "input": { "id": "builtin-skill", "index": 8, "name": "activate_skill", "arguments": "{\"skill_name\":\"release-notes\"}" },
      "expectedArgs": { "skill_name": "release-notes" },
      "expectedLocal": null,
      "terminal": false
    }
  ],
  "directMcp": {
    "input": { "id": "fixture-direct-mcp", "index": 8, "name": "filesystem|read/file", "arguments": "{\"path\":\"README.md\"}" },
    "expected": { "kind": "mcp", "name": "filesystem|read/file", "server": "filesystem", "tool": "read/file", "proxyName": "mcp__filesystem__read__file", "args": { "path": "README.md" } }
  },
  "useMcpTool": {
    "input": { "id": "fixture-use-mcp", "index": 9, "name": "use_mcp_tool", "arguments": "{\"serverName\":\"github\",\"toolName\":\"issues/get\",\"arguments\":{\"number\":7}}" },
    "expected": { "kind": "mcp", "name": "github|issues/get", "server": "github", "tool": "issues/get", "proxyName": "mcp__github__issues__get", "args": { "number": 7 } }
  },
  "resultPayloads": {
    "success": { "input": { "toolCallId": "fixture-success", "content": "ok" }, "expected": { "tool_call_id": "fixture-success", "content": "ok" } },
    "failure": { "input": { "toolCallId": "fixture-failure", "error": "denied" }, "expected": { "tool_call_id": "fixture-failure", "content": "", "error": "denied" } }
  },
  "turn": {
    "message": "hello",
    "metadata": { "source": "fixture" },
    "initialStream": [
      { "task": { "id": "task-1", "contextId": "ctx-1", "status": { "state": "TASK_STATE_SUBMITTED" } } },
      { "statusUpdate": { "taskId": "task-1", "contextId": "ctx-1", "status": { "state": "TASK_STATE_INPUT_REQUIRED", "message": { "messageId": "msg-before", "role": "ROLE_AGENT", "parts": [
        { "text": "before tool" },
        { "data": { "data_type": "tool_call", "data_version": 1, "id": "turn-tool", "index": 0, "function": { "name": "list_files", "arguments": "{\"path\":\"/workspace\"}" } } }
      ] } } } }
    ],
    "continuationStream": [
      { "statusUpdate": { "taskId": "task-1", "contextId": "ctx-1", "status": { "state": "TASK_STATE_COMPLETED", "message": { "messageId": "msg-after", "role": "ROLE_AGENT", "parts": [{ "text": "after tool" }] } } } }
    ],
    "execution": { "toolCallId": "turn-tool", "toolName": "list_files", "content": "file list" },
    "expected": {
      "eventTypes": ["status", "status", "status", "status", "text_delta", "tool_start", "tool_result", "text_complete", "status", "status", "status", "text_delta", "text_complete", "complete"],
      "textDeltas": ["before tool", "after tool"],
      "contextUpdates": [
        { "contextId": "ctx-1" },
        { "taskId": "task-1", "taskStatus": "submitted" },
        { "contextId": "ctx-1" },
        { "taskId": "task-1", "taskStatus": "input-required" },
        { "contextId": "ctx-1" },
        { "taskId": "task-1", "taskStatus": "completed" },
        { "clearTask": true, "taskStatus": "completed" }
      ],
      "messageCall": { "text": "hello", "metadata": { "source": "fixture" } },
      "toolResultCall": { "contextId": "ctx-1", "taskId": "task-1", "results": [{ "toolCallId": "turn-tool", "content": "file list" }] },
      "toolResultEvent": { "type": "tool_result", "toolUseId": "turn-tool", "toolName": "list_files", "result": "file list", "isError": false }
    }
  },
  "terminalHandoffs": [
    {
      "input": { "id": "terminal-ask", "index": 0, "name": "ask_followup_question", "arguments": "{\"question\":\"continue?\",\"followup\":[\"yes\",\"no\"]}" },
      "expectedText": "continue?\n1. yes\n2. no",
      "expectedContextUpdate": { "pendingTerminalTool": { "toolCallId": "terminal-ask", "name": "ask_followup_question" } },
      "expectedComplete": { "type": "complete", "terminalReason": "tool_deferred", "deferredToolUse": { "id": "terminal-ask", "name": "ask_followup_question", "input": { "question": "continue?", "followup": ["yes", "no"] } } }
    },
    {
      "input": { "id": "terminal-plan", "index": 1, "name": "plan_mode_respond", "arguments": "{\"response\":\"plan\"}" },
      "expectedText": "plan",
      "expectedContextUpdate": { "pendingTerminalTool": { "toolCallId": "terminal-plan", "name": "plan_mode_respond" } },
      "expectedComplete": { "type": "complete", "terminalReason": "tool_deferred", "deferredToolUse": { "id": "terminal-plan", "name": "plan_mode_respond", "input": { "response": "plan" } } }
    }
  ],
  "terminalAnswer": {
    "prompt": "yes, continue",
    "expectedToolResultCall": { "contextId": "ctx-1", "taskId": "task-1", "results": [{ "toolCallId": "terminal-ask", "content": "yes, continue" }] }
  }
}
