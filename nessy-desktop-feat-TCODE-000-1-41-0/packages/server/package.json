{
  "name": "@nessy-agent/server",
  "version": "1.0.2",
  "description": "Standalone headless Nessy Desktop server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "nessy-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "T-Bank",
    "email": "opensource@tbank.ru"
  },
  "license": "Apache-2.0",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nessy-agent/core": "workspace:*",
    "@nessy-agent/server-core": "workspace:*",
    "@nessy-agent/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
