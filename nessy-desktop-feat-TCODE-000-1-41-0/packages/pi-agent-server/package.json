{
  "name": "@nessy-agent/pi-agent-server",
  "version": "1.0.2",
  "license": "Apache-2.0",
  "description": "Out-of-process Pi agent server communicating via JSONL over stdio",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-agent-server": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun --format=esm && bun scripts/write-dist-package.ts",
    "typecheck": "bun run check:surface && bun run check:surface:selftest && tsc --noEmit -p tsconfig.typecheck.json",
    "check:surface": "bun src/harness/source-state-contract.ts",
    "check:surface:live": "bun src/harness/source-state-contract.ts --live-json-schema",
    "check:surface:selftest": "bun scripts/check-surface-selftest.ts",
    "validate": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@sinclair/typebox": "^0.34.0",
    "acorn": "8.17.0",
    "duck-duck-scrape": "^2.2.7",
    "koffi": "2.16.2",
    "node-html-parser": "^6.1.0",
    "pdfjs-dist": "^5.4.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
