{
  "name": "@nessy-agent/codex-agent-server",
  "version": "1.0.2",
  "license": "Apache-2.0",
  "description": "Manages the bundled codex app-server subprocess: JSON-RPC stdio client, runtime manager (spawn/kill), event mapper to Nessy AgentEvents, and (Phase 4) approval bridge.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app-server-client": "./src/app-server-client.ts",
    "./runtime-manager": "./src/runtime-manager.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nessy-agent/codex-protocol": "workspace:*",
    "@nessy-agent/core": "workspace:*",
    "@nessy-agent/codex-responses-adapter": "workspace:*"
  }
}
