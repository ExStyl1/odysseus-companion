{
  // The test half of this package's program, split from `tsconfig.json` on
  // purpose (P3.164).
  //
  // `packages/core` is the ONLY package in the repo with `"types": []`, and
  // that is a guard, not an oversight: core is the environment-free wire/types
  // package the renderer consumes, and an empty `types` is what stops
  // `process`, `Buffer` or a Bun global from ever compiling in its 14 source
  // files. Its one test file imports `bun:test`, which `"types": []` cannot
  // resolve — so making the test compile by adding `"types": ["bun"]` to
  // `tsconfig.json` would have bought a green typecheck by deleting the guard
  // from `src/` as well.
  //
  // Instead the chain runs BOTH: `tsc --noEmit` keeps src environment-free,
  // and this config puts the tests in a program of their own where `bun` types
  // exist. src is named here too so this program is complete rather than
  // whatever the tests happen to import.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "rootDir": "."
  },
  "include": ["src/**/*", "__tests__/**/*"]
}
